{
  "name": "@sineverba/check-domain",
  "version": "0.1.0",
  "description": "Checks if an email is part of a domain",
  "files": [
    "dist/**/*"
  ],
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sineverba/npm-pkg-check-domain.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --watchAll",
    "coverage": "jest --coverage",
    "lint": "tslint -p tsconfig.json",
    "prettier": "prettier -c \"src/**/*.ts\"",
    "fixprettier": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "npm",
    "package",
    "check",
    "email"
  ],
  "author": "alessandro.arici@gmail.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.4.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "coveralls": "^3.1.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "npm-check-updates": "^16.14.20",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.13.0"
  }
}
